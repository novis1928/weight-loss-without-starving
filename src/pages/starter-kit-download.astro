---
import Layout from "../layouts/Layout.astro";

const rawBaseURL = import.meta.env.BASE_URL;

const baseURL = rawBaseURL.endsWith("/")
  ? rawBaseURL
  : `${rawBaseURL}/`;

const asset = (path: string) =>
  `${baseURL.replace(/\/$/, "")}/${path.replace(/^\//, "")}`;

const pageTitle =
  "Download Your FREE Healthy Weight Loss Starter Kit | Weight Loss Without Starving";

const pageDescription =
  "Download your free Healthy Weight Loss Starter Kit and explore practical meal plans, nutrition guides, calculators, and the complete Weight Loss Without Starving eBook.";

const pdfUrl = asset(
  "downloads/free-healthy-weight-loss-starter-kit.pdf"
);

const ebookUrl = "https://payhip.com/b/eW3MA";

const resources = [
  {
    title: "High Protein Breakfast Recipes",
    description:
      "Start your day with satisfying, protein-rich breakfast ideas.",
    href: `${baseURL}blog/high-protein-breakfast-recipes-for-weight-loss/`,
  },
  {
    title: "Overnight Oats for Weight Loss",
    description:
      "Discover easy make-ahead breakfasts that help you stay full longer.",
    href: `${baseURL}blog/overnight-oats-for-weight-loss/`,
  },
  {
    title: "30 Best Foods for Weight Loss",
    description:
      "Build balanced meals with filling, nutrient-dense whole foods.",
    href: `${baseURL}blog/best-foods-for-weight-loss/`,
  },
  {
    title: "BMI Calculator",
    description:
      "Calculate your BMI and understand what the result means.",
    href: `${baseURL}tools/bmi-calculator/`,
  },
  {
    title: "Calorie Calculator",
    description:
      "Estimate your daily calorie needs based on your personal details.",
    href: `${baseURL}tools/calorie-calculator/`,
  },
  {
    title: "Macro Calculator",
    description:
      "Estimate a practical daily protein, carbohydrate, and fat target.",
    href: `${baseURL}tools/macro-calculator/`,
  },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <main>
    <section class="download-hero">
      <div class="download-container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">YOUR FREE DOWNLOAD IS READY</span>

          <h1>
            Your Healthy Weight Loss
            <span>Starter Kit Is Here</span>
          </h1>

          <p class="hero-text">
            Thank you for joining the Weight Loss Without Starving community.
            Your free Starter Kit is ready to download.
          </p>

          <div class="download-box">
            <div class="download-box-icon" aria-hidden="true">↓</div>

            <div>
              <strong>FREE Healthy Weight Loss Starter Kit</strong>
              <span>28 printable pages · PDF format</span>
            </div>
          </div>

          <div class="hero-actions">
            <a
              href={pdfUrl}
              class="primary-button"
              download="free-healthy-weight-loss-starter-kit.pdf"
            >
              Download Your FREE Starter Kit →
            </a>

            <a href="#next-steps" class="secondary-link">
              Explore your next steps
            </a>
          </div>

          <p class="download-help">
            If the download does not begin automatically, open the PDF and use
            the download icon in your browser.
          </p>
        </div>

        <div class="hero-visual">
          <div class="mockup-card">
            <img
              src={asset(
                "images/starter-kit/starter-kit-mockup.png"
              )}
              alt="FREE Healthy Weight Loss Starter Kit preview"
              width="1600"
              height="1200"
            />
          </div>

          <div class="free-badge">
            <strong>100% FREE</strong>
            <span>Instant PDF access</span>
          </div>
        </div>
      </div>
    </section>

    <section class="included-section">
      <div class="download-container">
        <header class="section-heading">
          <span class="eyebrow">START WITH THE BASICS</span>

          <h2>What to Do First</h2>

          <p>
            You do not need to change everything at once. Use the Starter Kit
            to build one simple habit at a time.
          </p>
        </header>

        <div class="steps-grid">
          <article>
            <span>01</span>
            <h3>Download the PDF</h3>
            <p>
              Save the Starter Kit to your computer or phone so you can return
              to it whenever you need it.
            </p>
          </article>

          <article>
            <span>02</span>
            <h3>Choose One Starting Point</h3>
            <p>
              Begin with the meal plan, grocery list, habit tracker, or portion
              guide—whichever feels most useful today.
            </p>
          </article>

          <article>
            <span>03</span>
            <h3>Keep It Simple</h3>
            <p>
              Focus on consistency rather than perfection. Small actions are
              easier to repeat and more likely to last.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="resources-section" id="next-steps">
      <div class="download-container">
        <header class="section-heading">
          <span class="eyebrow">KEEP MAKING PROGRESS</span>

          <h2>Free Recipes, Guides, and Calculators</h2>

          <p>
            Use these practical resources whenever you need fresh meal ideas,
            nutrition guidance, or help planning your next step.
          </p>
        </header>

        <div class="resources-grid">
          {resources.map((resource) => (
            <article class="resource-card">
              <h3>{resource.title}</h3>

              <p>{resource.description}</p>

              <a href={resource.href}>
                Open resource →
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="ebook-section">
      <div class="download-container ebook-grid">
        <div class="ebook-copy">
          <span class="eyebrow light">READY FOR THE COMPLETE SYSTEM?</span>

          <h2>Turn the Starter Kit Into a Sustainable Lifestyle</h2>

          <p>
            The full Weight Loss Without Starving eBook expands on the
            fundamentals with practical strategies, meal-planning guidance,
            recipes, and tools designed to help you build habits that last.
          </p>

          <ul>
            <li>✓ Practical weight-loss strategies</li>
            <li>✓ Simple meal-planning guidance</li>
            <li>✓ Sustainable habits without extreme restriction</li>
            <li>✓ Tools you can use again and again</li>
          </ul>

          <a
            href={ebookUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="ebook-button"
          >
            Get the Complete eBook →
          </a>
        </div>

        <div class="ebook-visual">
          <img
            src={asset("images/starter-kit/cta-banner.png")}
            alt="Weight Loss Without Starving complete eBook"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <section class="final-note">
      <div class="download-container final-note-inner">
        <div>
          <span class="eyebrow">YOU'VE ALREADY TAKEN THE FIRST STEP</span>

          <h2>Start With One Small Action Today</h2>

          <p>
            Download your Starter Kit, choose one page, and take one practical
            step. Progress grows from the habits you can repeat.
          </p>
        </div>

        <a
          href={pdfUrl}
          download="free-healthy-weight-loss-starter-kit.pdf"
        >
          Download the PDF →
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .download-container {
    width: min(1160px, calc(100% - 40px));
    margin: 0 auto;
  }

  .download-hero {
    padding: 92px 0;
    background:
      radial-gradient(
        circle at top right,
        rgba(34, 197, 94, 0.2),
        transparent 34%
      ),
      linear-gradient(180deg, #f0fdf4 0%, #ffffff 100%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(330px, 0.75fr);
    gap: 72px;
    align-items: center;
  }

  .eyebrow {
    display: inline-block;
    color: #15803d;
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .eyebrow.light {
    color: #86efac;
  }

  .hero-copy h1 {
    max-width: 720px;
    margin: 14px 0 0;
    color: #0f172a;
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 0.97;
    letter-spacing: -0.055em;
  }

  .hero-copy h1 span {
    display: block;
    color: #16a34a;
  }

  .hero-text {
    max-width: 680px;
    margin: 26px 0 0;
    color: #475569;
    font-size: 1.16rem;
    line-height: 1.75;
  }

  .download-box {
    display: flex;
    max-width: 680px;
    gap: 16px;
    align-items: center;
    margin-top: 30px;
    padding: 18px 20px;
    border: 1px solid #bbf7d0;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.86);
  }

  .download-box-icon {
    display: grid;
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    place-items: center;
    border-radius: 14px;
    background: #dcfce7;
    color: #15803d;
    font-size: 1.6rem;
    font-weight: 900;
  }

  .download-box strong,
  .download-box span {
    display: block;
  }

  .download-box strong {
    color: #163b2f;
    font-size: 1.05rem;
  }

  .download-box span {
    margin-top: 4px;
    color: #64748b;
    font-size: 0.92rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    margin-top: 30px;
  }

  .primary-button,
  .ebook-button,
  .final-note a {
    display: inline-flex;
    min-height: 56px;
    align-items: center;
    justify-content: center;
    padding: 0 25px;
    border-radius: 14px;
    background: #22c55e;
    color: #ffffff;
    font-weight: 900;
    text-decoration: none;
    box-shadow: 0 14px 30px rgba(34, 197, 94, 0.22);
  }

  .primary-button:hover,
  .ebook-button:hover,
  .final-note a:hover {
    background: #16a34a;
  }

  .secondary-link {
    color: #166534;
    font-weight: 800;
    text-decoration: none;
  }

  .secondary-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .download-help {
    margin: 16px 0 0;
    color: #94a3b8;
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .hero-visual {
    position: relative;
    width: min(100%, 460px);
    margin-left: auto;
    padding: 24px 34px 40px;
    perspective: 1400px;
  }

  .mockup-card {
    position: relative;
    z-index: 2;
    overflow: hidden;
    aspect-ratio: 2 / 3;
    border: 10px solid #ffffff;
    border-radius: 24px;
    background: #ffffff;
    transform: rotateY(-7deg) rotateX(2deg) rotateZ(1deg);
    box-shadow:
      0 44px 86px rgba(15, 23, 42, 0.24),
      0 14px 30px rgba(15, 23, 42, 0.14);
  }

  .mockup-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .free-badge {
    position: absolute;
    z-index: 3;
    right: 0;
    bottom: 64px;
    display: grid;
    gap: 3px;
    padding: 15px 19px;
    border: 4px solid #ffffff;
    border-radius: 18px;
    background: #0f172a;
    color: #ffffff;
    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.24);
  }

  .free-badge strong {
    color: #86efac;
  }

  .free-badge span {
    font-size: 0.78rem;
  }

  .included-section,
  .resources-section {
    padding: 96px 0;
  }

  .included-section {
    background: #ffffff;
  }

  .resources-section {
    background: #f8fafc;
  }

  .section-heading {
    max-width: 780px;
    margin: 0 auto 46px;
    text-align: center;
  }

  .section-heading h2,
  .ebook-copy h2,
  .final-note h2 {
    margin: 12px 0 0;
    color: #0f172a;
    font-size: clamp(2.25rem, 5vw, 3.7rem);
    line-height: 1.06;
    letter-spacing: -0.045em;
  }

  .section-heading p,
  .ebook-copy p,
  .final-note p {
    margin: 18px 0 0;
    color: #64748b;
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .steps-grid,
  .resources-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .steps-grid article,
  .resource-card {
    padding: 28px;
    border: 1px solid #dcfce7;
    border-radius: 20px;
    background: #f8fdf9;
  }

  .steps-grid article > span {
    color: #22c55e;
    font-size: 2rem;
    font-weight: 900;
  }

  .steps-grid h3,
  .resource-card h3 {
    margin: 16px 0 0;
    color: #163b2f;
    font-size: 1.25rem;
  }

  .steps-grid p,
  .resource-card p {
    margin: 10px 0 0;
    color: #64748b;
    line-height: 1.7;
  }

  .resource-card {
    display: flex;
    min-height: 220px;
    flex-direction: column;
    background: #ffffff;
  }

  .resource-card a {
    margin-top: auto;
    padding-top: 22px;
    color: #166534;
    font-weight: 900;
    text-decoration: none;
  }

  .resource-card a:hover {
    color: #15803d;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .ebook-section {
    padding: 96px 0;
    background: #081b11;
  }

  .ebook-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.8fr);
    gap: 70px;
    align-items: center;
  }

  .ebook-copy h2 {
    color: #ffffff;
  }

  .ebook-copy p {
    color: #b8c8bf;
  }

  .ebook-copy ul {
    display: grid;
    gap: 11px;
    margin: 26px 0 0;
    padding: 0;
    color: #dcfce7;
    font-weight: 800;
    list-style: none;
  }

  .ebook-button {
    margin-top: 30px;
  }

  .ebook-visual {
    overflow: hidden;
    border-radius: 22px;
    background: #ffffff;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.28);
  }

  .ebook-visual img {
    display: block;
    width: 100%;
    height: auto;
  }

  .final-note {
    padding: 72px 0;
    background: #ffffff;
  }

  .final-note-inner {
    display: flex;
    justify-content: space-between;
    gap: 42px;
    align-items: center;
  }

  .final-note-inner > div {
    max-width: 760px;
  }

  .final-note a {
    min-width: 210px;
    flex: 0 0 auto;
  }

  @media (max-width: 900px) {
    .hero-grid,
    .ebook-grid {
      grid-template-columns: 1fr;
    }

    .hero-visual {
      width: min(100%, 520px);
      margin: 10px auto 0;
    }

    .steps-grid,
    .resources-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .final-note-inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 620px) {
    .download-container {
      width: min(100% - 24px, 1160px);
    }

    .download-hero,
    .included-section,
    .resources-section,
    .ebook-section {
      padding: 64px 0;
    }

    .steps-grid,
    .resources-grid {
      grid-template-columns: 1fr;
    }

    .hero-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .primary-button,
    .secondary-link,
    .ebook-button,
    .final-note a {
      width: 100%;
      text-align: center;
    }

    .hero-visual {
      padding: 14px 24px 34px;
    }

    .mockup-card {
      border-width: 7px;
      border-radius: 18px;
      transform: none;
    }

    .free-badge {
      right: 8px;
      bottom: 18px;
    }
  }
</style>
