---
import PdfPage from "./PdfPage.astro";
const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base.replace(/\/$/, "")}/${path.replace(/^\//, "")}`;
---
<PdfPage id="habit-tracker" label="Build Consistency" title="Daily Habit Tracker" class="image-page">
  <img src={asset("images/starter-kit/daily-habit-tracker-infographic.png")} alt="Daily Habit Tracker" class="full-page-infographic" />
</PdfPage>
