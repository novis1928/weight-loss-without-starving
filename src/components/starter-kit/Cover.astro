---
const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base.replace(/\/$/, "")}/${path.replace(/^\//, "")}`;
---
<section class="pdf-page cover-page" id="cover">
  <img src={asset("images/starter-kit/hero-banner.png")}
       alt="FREE Healthy Weight Loss Starter Kit"
       class="cover-image" />
</section>
