---
import PdfPage from "./PdfPage.astro";

const base = import.meta.env.BASE_URL;

const asset = (path: string) =>
  `${base.replace(/\/$/, "")}/${path.replace(/^\//, "")}`;

const groups = [
  {
    title: "Protein",
    items: [
      "Chicken breast",
      "Turkey breast",
      "Lean beef",
      "Salmon",
      "Tuna",
      "Cod",
      "Eggs",
      "Greek yogurt",
      "Cottage cheese",
      "Tofu",
      "Tempeh",
      "Lentils",
      "Chickpeas",
    ],
  },
  {
    title: "Vegetables",
    items: [
      "Spinach",
      "Broccoli",
      "Cauliflower",
      "Bell peppers",
      "Tomatoes",
      "Cucumbers",
      "Carrots",
      "Zucchini",
      "Mushrooms",
      "Green beans",
      "Lettuce",
      "Asparagus",
    ],
  },
  {
    title: "Fruit",
    items: [
      "Apples",
      "Bananas",
      "Blueberries",
      "Strawberries",
      "Raspberries",
      "Oranges",
      "Pears",
      "Kiwi",
      "Grapes",
      "Lemons",
    ],
  },
  {
    title: "Whole Grains & Carbohydrates",
    items: [
      "Rolled oats",
      "Brown rice",
      "Quinoa",
      "Whole wheat pasta",
      "Whole grain bread",
      "Whole wheat tortillas",
      "Potatoes",
      "Sweet potatoes",
    ],
  },
  {
    title: "Healthy Fats",
    items: [
      "Avocados",
      "Almonds",
      "Walnuts",
      "Chia seeds",
      "Flaxseeds",
      "Pumpkin seeds",
      "Olive oil",
      "Natural peanut butter",
    ],
  },
  {
    title: "Pantry Essentials",
    items: [
      "Black pepper",
      "Paprika",
      "Cinnamon",
      "Oregano",
      "Basil",
      "Chili flakes",
      "Mustard",
      "Balsamic vinegar",
      "Low-sodium soy sauce",
      "Garlic",
    ],
  },
];
---

<PdfPage
  id="grocery-list"
  label="Shop With a Plan"
  title="Healthy Grocery List"
  class="image-page"
>
  <img
    src={asset("images/starter-kit/healthy-grocery-list-infographic.png")}
    alt="Healthy Grocery List"
    class="full-page-infographic"
  />
</PdfPage>

<PdfPage
  id="printable-grocery-list"
  label="Printable Checklist"
  title="Complete Healthy Grocery List"
>
  <p class="grocery-intro">
    Use this checklist before shopping. You do not need to buy everything each
    week—choose the foods that match your meal plan, preferences, and budget.
  </p>

  <div class="grocery-checklist-grid">
    {groups.map((group) => (
      <section class="grocery-group">
        <h3>{group.title}</h3>

        <ul>
          {group.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <div class="grocery-tips">
    <article>
      <h3>Smart Shopping Tips</h3>
      <ul>
        <li>Shop with a written list.</li>
        <li>Choose mostly minimally processed foods.</li>
        <li>Compare prices per kilogram or unit.</li>
        <li>Use frozen vegetables and fruit when convenient.</li>
      </ul>
    </article>

    <article>
      <h3>Budget-Friendly Choices</h3>
      <ul>
        <li>Eggs, lentils, beans, oats, and canned tuna.</li>
        <li>Seasonal produce and store-brand products.</li>
        <li>Buy larger packs only when you will use them.</li>
        <li>Plan meals around foods already at home.</li>
      </ul>
    </article>
  </div>
</PdfPage>