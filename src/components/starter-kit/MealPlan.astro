---

<PdfPage
  id="meal-plan"
  label="Your First Week"
  title="7-Day Healthy Weight Loss Meal Plan"
  class="image-page"
>
  <img
    src={asset("images/starter-kit/meal-plan-overview-infographic.png")}
    alt="7-Day Healthy Weight Loss Meal Plan Overview"
    class="full-page-infographic"
  />
</PdfPage>

{days.map((day) => (
  <PdfPage
    id={`meal-plan-${day.day.toLowerCase().replace(" ", "-")}`}
    label="7-Day Meal Plan"
    title={day.day}
  >
    <p class="day-intro">
      {day.intro}
    </p>

    <div class="daily-nutrition">
      <div>
        <span>Estimated calories</span>
        <strong>{day.calories}</strong>
      </div>

      <div>
        <span>Estimated protein</span>
        <strong>{day.protein}</strong>
      </div>
    </div>

    <div class="meal-detail-grid">
      {day.meals.map((meal, index) => (
        <article
          class:list={[
            "meal-detail-card",
            index === day.meals.length - 1 && "meal-detail-wide",
          ]}
        >
          <span>{meal.type}</span>

          <h3>{meal.title}</h3>

          <ul>
            {meal.ingredients.map((ingredient) => (
              <li>{ingredient}</li>
            ))}
          </ul>

          {meal.method && (
            <p>
              {meal.method}
            </p>
          )}
        </article>
      ))}
    </div>

    <div class="tip-box">
      <strong>Easy substitutions:</strong>
      {day.substitutions}
    </div>
  </PdfPage>
))}