---
const rawBaseURL = import.meta.env.BASE_URL;

const baseURL = rawBaseURL.endsWith("/")
  ? rawBaseURL
  : `${rawBaseURL}/`;

const imageURL =
  `${baseURL}images/starter-kit/starter-kit-mockup.png`;
---

<section
  class="starter-kit-signup"
  aria-labelledby="starter-kit-signup-title"
>
  <div class="starter-kit-container">
    <div class="starter-kit-copy">
      <div class="starter-kit-topline">
        <span class="gift-mark" aria-hidden="true">🎁</span>

        <span class="starter-kit-eyebrow">
          FREE HEALTHY WEIGHT LOSS STARTER KIT
        </span>
      </div>

      <h2 id="starter-kit-signup-title">
        Everything You Need to Start
        <span>Losing Weight Without Starving</span>
      </h2>

      <p class="starter-kit-description">
        Get a practical 28-page PDF with a simple 7-day meal plan,
        printable tools, nutrition guides, and realistic strategies you
        can start using today.
      </p>

      <div class="starter-kit-proof">
        <div class="proof-stars" aria-label="Five stars">★★★★★</div>

        <p>
          Practical resources for healthy, sustainable weight loss without
          extreme diets or complicated rules.
        </p>
      </div>

      <ul class="starter-kit-benefits">
        <li><span aria-hidden="true">✓</span>7-day healthy meal plan</li>
        <li><span aria-hidden="true">✓</span>Printable grocery list</li>
        <li><span aria-hidden="true">✓</span>Weekly meal planner</li>
        <li><span aria-hidden="true">✓</span>Daily habit tracker</li>
        <li><span aria-hidden="true">✓</span>Healthy portion guide</li>
        <li><span aria-hidden="true">✓</span>Protein cheat sheet</li>
      </ul>

      <div
        id="mlb2-44518335"
        class="starter-mailerlite-form ml-subscribe-form ml-subscribe-form-44518335"
      >
        <div class="starter-form-content row-form">
          <div class="form-heading">
            <strong>Where should we send your free Starter Kit?</strong>
            <span>Enter your best email address below.</span>
          </div>

          <form
            class="signup-form ml-block-form"
            action="https://assets.mailerlite.com/jsonp/2557668/forms/194964919852992431/subscribe"
            method="post"
            target="_blank"
          >
            <label for="starter-email-home">
              Email address
            </label>

            <input
              id="starter-email-home"
              aria-label="Email address"
              aria-required="true"
              name="fields[email]"
              type="email"
              autocomplete="email"
              inputmode="email"
              placeholder="you@example.com"
              required
            />

            <input type="hidden" name="ml-submit" value="1" />
            <input type="hidden" name="anticsrf" value="true" />

            <button type="submit" class="primary">
              <span class="button-text">
                <span aria-hidden="true">↓</span>
                Download My FREE Starter Kit
              </span>

              <span class="button-loading" aria-hidden="true">
                Sending…
              </span>
            </button>
          </form>

          <div class="starter-kit-trust">
            <span>✓ Free 28-page PDF</span>
            <span>✓ Instant access</span>
            <span>✓ No credit card required</span>
          </div>

          <p class="privacy-note">
            No spam. Unsubscribe anytime.
          </p>
        </div>

        <div
          class="starter-form-success row-success"
          style="display: none;"
          role="status"
          aria-live="polite"
        >
          <span class="success-icon" aria-hidden="true">✓</span>

          <div>
            <strong>Check your inbox!</strong>

            <p>
              Please confirm your email to receive your FREE Healthy Weight
              Loss Starter Kit. Check Promotions or Spam if it does not arrive
              within a few minutes.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="starter-kit-visual">
      <div class="starter-kit-image-card">
        <img
          src={imageURL}
          alt="FREE Healthy Weight Loss Starter Kit preview"
          loading="lazy"
          width="1600"
          height="1200"
        />
      </div>

      <div class="starter-kit-shadow" aria-hidden="true"></div>

      <div class="starter-kit-badge">
        <strong>100% FREE</strong>
        <span>28-page printable PDF</span>
      </div>

      <div class="starter-kit-mini-card mini-card-one">
        <strong>28</strong>
        <span>Printable pages</span>
      </div>

      <div class="starter-kit-mini-card mini-card-two">
        <strong>7-Day</strong>
        <span>Meal plan included</span>
      </div>
    </div>
  </div>

  <div class="starter-kit-stats">
    <article>
      <strong>28</strong>
      <span>Printable pages</span>
    </article>

    <article>
      <strong>7-Day</strong>
      <span>Healthy meal plan</span>
    </article>

    <article>
      <strong>6</strong>
      <span>Practical tools</span>
    </article>

    <article>
      <strong>100%</strong>
      <span>Free download</span>
    </article>
  </div>
</section>

<script is:inline>
  window.ml_webform_success_44518335 = function () {
    const formContainer = document.querySelector(
      ".ml-subscribe-form-44518335"
    );

    if (!formContainer) return;

    const formContent = formContainer.querySelector(".row-form");
    const successContent = formContainer.querySelector(".row-success");

    if (formContent) {
      formContent.style.display = "none";
    }

    if (successContent) {
      successContent.style.display = "flex";
    }
  };
</script>

<script
  is:inline
  src="https://groot.mailerlite.com/js/w/webforms.min.js?v83147fa8ce2d95cb73ece7f28b469519"
></script>

<script is:inline>
  fetch(
    "https://assets.mailerlite.com/jsonp/2557668/forms/194964919852992431/takel"
  ).catch(() => {
    // Tracking must never block the signup form.
  });
</script>

<style>
  .starter-kit-signup {
    position: relative;
    overflow: hidden;
    padding: 108px 0 0;
    border-top: 1px solid #dcfce7;
    border-bottom: 1px solid #dcfce7;
    background:
      radial-gradient(
        circle at 88% 18%,
        rgba(34, 197, 94, 0.22),
        transparent 28%
      ),
      radial-gradient(
        circle at 8% 82%,
        rgba(134, 239, 172, 0.24),
        transparent 24%
      ),
      linear-gradient(
        180deg,
        #effcf3 0%,
        #f8fff9 52%,
        #ffffff 100%
      );
  }

  .starter-kit-container {
    display: grid;
    width: min(1220px, calc(100% - 40px));
    grid-template-columns: minmax(0, 1.05fr) minmax(380px, 0.88fr);
    gap: 82px;
    align-items: center;
    margin: 0 auto;
  }

  .starter-kit-copy {
    max-width: 730px;
  }

  .starter-kit-topline {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .gift-mark {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid #bbf7d0;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.88);
    box-shadow: 0 10px 24px rgba(34, 197, 94, 0.12);
    font-size: 1.2rem;
  }

  .starter-kit-eyebrow {
    color: #15803d;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .starter-kit-copy h2 {
    margin: 20px 0 0;
    color: #0f172a;
    font-size: clamp(3rem, 6.2vw, 5.25rem);
    line-height: 0.98;
    letter-spacing: -0.057em;
  }

  .starter-kit-copy h2 span {
    display: block;
    color: #16a34a;
  }

  .starter-kit-description {
    max-width: 680px;
    margin: 26px 0 0;
    color: #475569;
    font-size: 1.14rem;
    line-height: 1.78;
  }

  .starter-kit-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    align-items: center;
    margin-top: 22px;
    padding: 15px 18px;
    border: 1px solid #dcfce7;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.72);
  }

  .proof-stars {
    color: #f59e0b;
    font-size: 1.02rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .starter-kit-proof p {
    flex: 1 1 340px;
    margin: 0;
    color: #334155;
    font-size: 0.94rem;
    font-weight: 750;
    line-height: 1.55;
  }

  .starter-kit-benefits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 13px 26px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .starter-kit-benefits li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    color: #163b2f;
    font-weight: 850;
    line-height: 1.45;
  }

  .starter-kit-benefits li span {
    display: grid;
    width: 22px;
    height: 22px;
    flex: 0 0 22px;
    place-items: center;
    margin-top: 1px;
    border-radius: 50%;
    background: #dcfce7;
    color: #15803d;
    font-size: 0.78rem;
    font-weight: 900;
  }

  .starter-mailerlite-form {
    width: 100%;
    margin-top: 34px;
    padding: 24px;
    border: 1px solid #bbf7d0;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.97);
    box-shadow:
      0 28px 70px rgba(15, 23, 42, 0.13),
      0 10px 28px rgba(34, 197, 94, 0.08);
  }

  .form-heading {
    display: grid;
    gap: 5px;
    margin-bottom: 16px;
  }

  .form-heading strong {
    color: #163b2f;
    font-size: 1.12rem;
  }

  .form-heading span {
    color: #64748b;
    font-size: 0.9rem;
  }

  .signup-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 12px;
    margin: 0;
  }

  .signup-form label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .signup-form input[type="email"] {
    min-width: 0;
    min-height: 62px;
    padding: 0 19px;
    border: 1px solid #cbd5e1;
    border-radius: 16px;
    background: #ffffff;
    color: #0f172a;
    font: inherit;
    font-size: 1rem;
  }

  .signup-form input[type="email"]:focus {
    border-color: #22c55e;
    outline: 4px solid rgba(34, 197, 94, 0.14);
  }

  .signup-form button {
    min-height: 62px;
    padding: 0 28px;
    border: 0;
    border-radius: 16px;
    background: linear-gradient(
      135deg,
      #22c55e 0%,
      #16a34a 100%
    );
    color: #ffffff;
    font: inherit;
    font-weight: 900;
    cursor: pointer;
    box-shadow: 0 15px 32px rgba(34, 197, 94, 0.28);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .button-text {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    white-space: nowrap;
  }

  .signup-form button:hover {
    box-shadow: 0 20px 42px rgba(34, 197, 94, 0.38);
    transform: translateY(-2px);
  }

  .signup-form button:focus-visible {
    outline: 3px solid rgba(34, 197, 94, 0.32);
    outline-offset: 4px;
  }

  .button-loading {
    display: none;
  }

  .starter-kit-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 17px;
    margin-top: 16px;
    color: #166534;
    font-size: 0.86rem;
    font-weight: 850;
  }

  .privacy-note {
    margin: 10px 0 0;
    color: #94a3b8;
    font-size: 0.8rem;
  }

  .starter-form-success {
    align-items: flex-start;
    gap: 14px;
    padding: 21px;
    border: 1px solid #86efac;
    border-radius: 17px;
    background: #f0fdf4;
  }

  .success-icon {
    display: grid;
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    place-items: center;
    border-radius: 50%;
    background: #22c55e;
    color: #ffffff;
    font-weight: 900;
  }

  .starter-form-success strong {
    display: block;
    color: #163b2f;
    font-size: 1.15rem;
  }

  .starter-form-success p {
    margin: 7px 0 0;
    color: #166534;
    line-height: 1.65;
  }

  .starter-kit-visual {
    position: relative;
    width: min(100%, 560px);
    margin-left: auto;
    padding: 36px 46px 58px;
    perspective: 1500px;
  }

  .starter-kit-image-card {
    position: relative;
    z-index: 3;
    overflow: hidden;
    border: 11px solid #ffffff;
    border-radius: 30px;
    background: #ffffff;
    box-shadow:
      0 52px 100px rgba(15, 23, 42, 0.25),
      0 18px 42px rgba(15, 23, 42, 0.14);
    transform: rotateY(-7deg) rotateX(2deg) rotateZ(1deg);
  }

  .starter-kit-image-card img {
    display: block;
    width: 100%;
    height: auto;
  }

  .starter-kit-shadow {
    position: absolute;
    z-index: 1;
    right: 7%;
    bottom: 22px;
    left: 13%;
    height: 44px;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.22);
    filter: blur(20px);
  }

  .starter-kit-badge {
    position: absolute;
    z-index: 5;
    right: 2px;
    bottom: 72px;
    display: grid;
    gap: 3px;
    padding: 17px 21px;
    border: 4px solid #ffffff;
    border-radius: 20px;
    background: #0f172a;
    color: #ffffff;
    box-shadow: 0 20px 48px rgba(15, 23, 42, 0.26);
  }

  .starter-kit-badge strong {
    color: #86efac;
    font-size: 1rem;
  }

  .starter-kit-badge span {
    font-size: 0.79rem;
  }

  .starter-kit-mini-card {
    position: absolute;
    z-index: 4;
    display: grid;
    gap: 2px;
    min-width: 126px;
    padding: 13px 15px;
    border: 1px solid #dcfce7;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 16px 38px rgba(15, 23, 42, 0.14);
  }

  .starter-kit-mini-card strong {
    color: #16a34a;
    font-size: 1.25rem;
  }

  .starter-kit-mini-card span {
    color: #475569;
    font-size: 0.74rem;
    font-weight: 750;
  }

  .mini-card-one {
    top: 8px;
    left: 0;
  }

  .mini-card-two {
    top: 36%;
    right: 4px;
  }

  .starter-kit-stats {
    display: grid;
    width: min(1220px, calc(100% - 40px));
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 88px auto 0;
    padding: 26px 0 30px;
    border-top: 1px solid rgba(34, 197, 94, 0.16);
  }

  .starter-kit-stats article {
    display: grid;
    gap: 6px;
    padding: 20px;
    text-align: center;
  }

  .starter-kit-stats strong {
    color: #16a34a;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
  }

  .starter-kit-stats span {
    color: #334155;
    font-size: 0.9rem;
    font-weight: 850;
  }

  @media (max-width: 1040px) {
    .starter-kit-container {
      grid-template-columns: 1fr;
      gap: 58px;
    }

    .starter-kit-copy {
      max-width: none;
    }

    .starter-kit-visual {
      width: min(100%, 590px);
      margin: 0 auto;
    }
  }

  @media (max-width: 760px) {
    .signup-form {
      grid-template-columns: 1fr;
    }

    .signup-form button {
      width: 100%;
    }

    .button-text {
      justify-content: center;
    }

    .starter-kit-benefits {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .starter-kit-signup {
      padding: 72px 0 0;
    }

    .starter-kit-container,
    .starter-kit-stats {
      width: calc(100% - 24px);
    }

    .starter-kit-copy h2 {
      font-size: clamp(2.55rem, 13vw, 3.7rem);
    }

    .starter-kit-proof {
      align-items: flex-start;
      flex-direction: column;
    }

    .starter-mailerlite-form {
      padding: 18px;
      border-radius: 20px;
    }

    .starter-kit-trust {
      align-items: flex-start;
      flex-direction: column;
    }

    .privacy-note {
      text-align: center;
    }

    .starter-kit-visual {
      padding: 30px 20px 44px;
    }

    .starter-kit-image-card {
      border-width: 7px;
      border-radius: 22px;
      transform: none;
    }

    .starter-kit-mini-card {
      display: none;
    }

    .starter-kit-badge {
      right: 6px;
      bottom: 22px;
    }

    .starter-kit-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 54px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signup-form button,
    .starter-kit-image-card {
      transition: none;
      transform: none;
    }
  }
</style>
