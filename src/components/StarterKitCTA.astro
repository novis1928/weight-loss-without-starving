---
const rawBaseURL = import.meta.env.BASE_URL;

const baseURL = rawBaseURL.endsWith("/")
  ? rawBaseURL
  : `${rawBaseURL}/`;

const starterKitURL = `${baseURL}free-starter-kit/`;
const ebookURL = "https://payhip.com/b/eW3MA";

const imageURL =
  `${baseURL}images/starter-kit/starter-kit-mockup.png`;
---

<aside
  class="starter-kit-cta"
  aria-labelledby="starter-kit-cta-title"
>
  <div class="starter-kit-cta-copy">
    <span class="starter-kit-cta-eyebrow">
      🎁 FREE HEALTHY WEIGHT LOSS STARTER KIT
    </span>

    <h2 id="starter-kit-cta-title">
      Enjoying this article?
      <span>Take the next step for free.</span>
    </h2>

    <p class="starter-kit-cta-description">
      Get the FREE 28-page Healthy Weight Loss Starter Kit with practical
      meal-planning tools, nutrition guides, and simple habits you can start
      using today.
    </p>

    <ul class="starter-kit-cta-benefits">
      <li>7-day healthy meal plan</li>
      <li>Printable grocery list</li>
      <li>Weekly meal planner</li>
      <li>Daily habit tracker</li>
      <li>Healthy portion guide</li>
      <li>Protein cheat sheet</li>
    </ul>

    <div class="starter-kit-cta-actions">
      <a
        href={starterKitURL}
        class="starter-kit-primary-button"
      >
        Get My FREE Starter Kit →
      </a>

      <span class="starter-kit-cta-note">
        Free PDF · Instant access · No credit card required
      </span>
    </div>

    <div class="starter-kit-ebook-link">
      <span>Ready for the complete system?</span>

      <a
        href={ebookURL}
        target="_blank"
        rel="noopener noreferrer"
      >
        Explore the complete eBook →
      </a>
    </div>
  </div>

  <div class="starter-kit-cta-visual">
    <div class="starter-kit-cta-image">
      <img
        src={imageURL}
        alt="FREE Healthy Weight Loss Starter Kit preview"
        loading="lazy"
        width="1600"
        height="1200"
      />
    </div>

    <div class="starter-kit-cta-badge">
      <strong>100% FREE</strong>
      <span>28-page printable PDF</span>
    </div>
  </div>
</aside>

<style>
  .starter-kit-cta {
    position: relative;
    display: grid;
    grid-template-columns:
      minmax(0, 1.1fr)
      minmax(250px, 0.62fr);
    gap: 44px;
    align-items: center;
    overflow: hidden;
    margin: 64px 0;
    padding: 42px;
    border: 1px solid #bbf7d0;
    border-radius: 28px;
    background:
      radial-gradient(
        circle at top right,
        rgba(34, 197, 94, 0.2),
        transparent 34%
      ),
      linear-gradient(
        135deg,
        #f0fdf4 0%,
        #ffffff 62%,
        #f8fff9 100%
      );
    box-shadow:
      0 26px 65px rgba(15, 23, 42, 0.11),
      0 8px 22px rgba(34, 197, 94, 0.08);
  }

  .starter-kit-cta::before {
    content: "";
    position: absolute;
    top: -110px;
    left: -110px;
    width: 250px;
    height: 250px;
    border-radius: 50%;
    background: rgba(34, 197, 94, 0.08);
    pointer-events: none;
  }

  .starter-kit-cta-copy,
  .starter-kit-cta-visual {
    position: relative;
    z-index: 1;
  }

  .starter-kit-cta-eyebrow {
    display: inline-block;
    color: #15803d;
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.11em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .starter-kit-cta h2 {
    margin: 14px 0 0;
    color: #0f172a;
    font-size: clamp(2rem, 4vw, 3.15rem);
    line-height: 1.03;
    letter-spacing: -0.045em;
  }

  .starter-kit-cta h2 span {
    display: block;
    color: #16a34a;
  }

  .starter-kit-cta-description {
    max-width: 690px;
    margin: 19px 0 0;
    color: #475569;
    font-size: 1.02rem;
    line-height: 1.72;
  }

  .starter-kit-cta-benefits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 22px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .starter-kit-cta-benefits li {
    position: relative;
    padding-left: 28px;
    color: #163b2f;
    font-size: 0.95rem;
    font-weight: 800;
    line-height: 1.45;
  }

  .starter-kit-cta-benefits li::before {
    content: "✓";
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    width: 20px;
    height: 20px;
    place-items: center;
    border-radius: 50%;
    background: #dcfce7;
    color: #15803d;
    font-size: 0.72rem;
    font-weight: 900;
  }

  .starter-kit-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 18px;
    align-items: center;
    margin-top: 28px;
  }

  .starter-kit-primary-button {
    display: inline-flex;
    min-height: 58px;
    align-items: center;
    justify-content: center;
    padding: 0 27px;
    border-radius: 999px;
    background:
      linear-gradient(
        135deg,
        #22c55e 0%,
        #16a34a 100%
      );
    color: #ffffff !important;
    font-size: 0.98rem;
    font-weight: 900;
    text-decoration: none !important;
    box-shadow: 0 14px 32px rgba(34, 197, 94, 0.27);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }

  .starter-kit-primary-button:hover,
  .starter-kit-primary-button:focus-visible {
    background:
      linear-gradient(
        135deg,
        #16a34a 0%,
        #15803d 100%
      );
    box-shadow: 0 19px 42px rgba(34, 197, 94, 0.36);
    transform: translateY(-3px);
  }

  .starter-kit-primary-button:focus-visible {
    outline: 3px solid rgba(34, 197, 94, 0.3);
    outline-offset: 4px;
  }

  .starter-kit-cta-note {
    color: #64748b;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .starter-kit-ebook-link {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    align-items: center;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid #dcfce7;
    color: #64748b;
    font-size: 0.91rem;
  }

  .starter-kit-ebook-link a {
    color: #166534;
    font-weight: 900;
    text-decoration: none;
  }

  .starter-kit-ebook-link a:hover {
    color: #15803d;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .starter-kit-cta-visual {
    width: min(100%, 330px);
    margin-left: auto;
    padding: 14px 24px 34px;
    perspective: 1300px;
  }

  .starter-kit-cta-image {
    overflow: hidden;
    border: 8px solid #ffffff;
    border-radius: 22px;
    background: #ffffff;
    box-shadow:
      0 36px 72px rgba(15, 23, 42, 0.23),
      0 12px 28px rgba(15, 23, 42, 0.12);
    transform:
      rotateY(-7deg)
      rotateX(2deg)
      rotateZ(1deg);
  }

  .starter-kit-cta-image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .starter-kit-cta-badge {
    position: absolute;
    right: 0;
    bottom: 10px;
    display: grid;
    gap: 2px;
    padding: 12px 15px;
    border: 3px solid #ffffff;
    border-radius: 15px;
    background: #0f172a;
    color: #ffffff;
    box-shadow: 0 15px 38px rgba(15, 23, 42, 0.22);
  }

  .starter-kit-cta-badge strong {
    color: #86efac;
    font-size: 0.86rem;
  }

  .starter-kit-cta-badge span {
    font-size: 0.68rem;
  }

  @media (max-width: 820px) {
    .starter-kit-cta {
      grid-template-columns: 1fr;
      padding: 36px;
    }

    .starter-kit-cta-visual {
      width: min(100%, 390px);
      margin: 0 auto;
    }
  }

  @media (max-width: 560px) {
    .starter-kit-cta {
      margin: 48px 0;
      padding: 28px 20px;
      border-radius: 22px;
    }

    .starter-kit-cta-benefits {
      grid-template-columns: 1fr;
    }

    .starter-kit-cta-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .starter-kit-primary-button {
      width: 100%;
      text-align: center;
    }

    .starter-kit-cta-note {
      text-align: center;
    }

    .starter-kit-cta-visual {
      padding: 10px 22px 30px;
    }

    .starter-kit-cta-image {
      border-width: 6px;
      border-radius: 18px;
      transform: none;
    }

    .starter-kit-cta-badge {
      right: 4px;
      bottom: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .starter-kit-primary-button,
    .starter-kit-cta-image {
      transition: none;
      transform: none;
    }
  }
</style>
